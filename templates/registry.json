{
  "version": 1,
  "place": "/var/lib/diting/templates",
  "rule": "模板在浏览器自己的目录里。调用方只交 JSON 和模板名。HTML 在点开、调起浏览器时才生成。",
  "templates": [
    {
      "id": "weather",
      "file": "weather.html",
      "title": "天气预报",
      "matches": ["天气", "气温", "weather", "预报"],
      "slots": ["city", "temp", "condition", "low", "high", "humidity", "uv", "source_url"],
      "panel": "1080x2340"
    },
    {
      "id": "reply",
      "file": "reply.html",
      "title": "回复",
      "matches": [],
      "slots": ["question", "body"],
      "panel": "1080x2340",
      "note": "没有专用结果模板时的正文页。"
    },
    {
      "id": "findings",
      "file": "findings.html",
      "title": "检索成果",
      "matches": ["公众号", "微信", "搜狗", "检索"],
      "slots": ["question", "via", "count", "read", "body"],
      "panel": "1080x2340",
      "note": "检索成果页。body 是 markdown，点开时在模板里画成正文。"
    },
    {
      "id": "gzh",
      "file": "gzh.html",
      "title": "公众号文章",
      "matches": ["公众号文章", "成稿", "gzh"],
      "slots": ["title", "account", "author", "date", "body"],
      "panel": "1080x2340",
      "note": "公众号成稿页。body 是 markdown，点开时在模板里画成正文。"
    },
    {
      "id": "qr",
      "file": "qr.html",
      "title": "扫码",
      "matches": ["扫码", "二维码", "qr"],
      "slots": ["title", "subtitle", "svg_b64", "url"],
      "panel": "1080x2340",
      "note": "二维码上屏页。svg_b64=base64(SVG)（ASCII，白底黑模块含静区），页内 atob 还原——base64 字母表无转义字符，过转义槽无损。"
    }
  ]
}
