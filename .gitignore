# Rust
/target/
**/*.rs.bk

# V8 snapshot / build artifacts
*.bin

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs / runtime
*.log
cookie-store.json

# Local npx skills install artifacts / session state
.agents/
.claude/
skills-lock.json

# Local publisher tooling binary
mcp-publisher

# Local fetch/search SQLite cache (runtime state, must never rsync to hosted instance)
cache.db
cache.db-shm
cache.db-wal

# Local vendored source trees pulled for reference (e.g. deno_core during musl port)
vendor/

# docs/ is local-only — design notes, feedback, references, guides: never
# committed, never pushed, never packaged. What the software itself reads
# lives next to the code that reads it (workflow/, config/, crates/…).
docs/

# localStorage persistence test artifact (runtime state, must never rsync to hosted instance)
/localStorage/

# User-pulled reference bundles at repo root — never commit
/TurnstileLogin.bundle.js
/api.js
/index.web-*.js

# agent/local scratch (Claude memory imports, etc.) — never committed
.local/

# working docs & credentials — never committed
HANDOFF-*.md
scripts/__pycache__/

# Editor / agent scratch backups next to flows
*.bak
*.bak-*
**/*.bak
**/*.bak-*

# Local desktop UI experiment (not part of the product tree)
/desktop.js

# Agent scratch/forensics — runtime state & credentials, never commit (2026-10-16 audit S1)
/tmp-agent/

# local artifacts — session cookies NEVER commit
bench/peer-publish-*/
recordings/
templates/findings.html
templates/gzh.html
web/zcode*

# overlay 合成构建目录（apply.py 输出的独立 target，与 /target/ 平行）
/target-ov/

# 运营脚本/探测取证的仓库根杂物（X 发帖 _post_*、探测 _probe_*）——never commit
/_post_*
/_probe_*

# JS platform dependency analyzer deps (package-lock.json is committed)
/tools/webplatform/analyze/node_modules/
__pycache__/
